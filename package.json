{
  "name": "hyde-db",
  "version": "1.0.0",
  "description": "Prisma generator that turns /// @hyde annotations into read-only PostgreSQL or MySQL views with sensitive columns removed, plus a locked-down reader role",
  "keywords": [
    "prisma",
    "prisma-generator",
    "postgresql",
    "mysql",
    "privacy",
    "pii",
    "redaction",
    "views",
    "read-only",
    "llm",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bergbacher/hyde-db.git"
  },
  "homepage": "https://github.com/bergbacher/hyde-db#readme",
  "bugs": "https://github.com/bergbacher/hyde-db/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "hyde-db": "./dist/generator.mjs"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "packageManager": "pnpm@10.34.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:integration:mysql": "vitest run --project integration-mysql",
    "test:e2e": "node scripts/pack-e2e.mjs && node --test test/e2e/*.test.mjs",
    "changeset": "changeset",
    "golden": "node scripts/update-golden.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "5.0.3",
    "pg": "^8.23.1",
    "prisma-schema-wasm-6": "npm:@prisma/prisma-schema-wasm@7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "prisma-schema-wasm-7": "npm:@prisma/prisma-schema-wasm@7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "publint": "0.3.25",
    "tsdown": "~0.23.0",
    "typescript": "~7.0.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "cpu-features",
      "protobufjs",
      "ssh2"
    ]
  }
}
