// Characterization case "loose": exercises the non-strict rules of the base
// (global hidden default, @hyde.default(visible), relation hints, a model without
// visible columns, an explicitly visible sensitive name).
generator redacted {
  provider = "hyde-db"
  output   = "./redacted"
  strict   = "false"
}

datasource db {
  provider = "postgresql"
}

/// Product catalogue entry.
/// @hyde.default(visible)
model Product {
  id          Int       @id
  title       String
  /// Price in cents
  priceCents  Int       @map("price_cents")
  /// @hyde.hidden
  supplierRef String    @map("supplier_ref")
  tags        String[]
  status      Status
  categoryId  Int?      @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model Category {
  /// @hyde.visible
  id           Int       @id
  /// @hyde.visible
  /// Display label
  label        String
  internalCode String    @map("internal_code")
  /// @hyde.visible
  /// Public support inbox
  supportEmail String    @map("support_email")
  products     Product[]
}

model Session {
  id        String @id
  userAgent String @map("user_agent")
}

enum Status {
  DRAFT
  LIVE
}
