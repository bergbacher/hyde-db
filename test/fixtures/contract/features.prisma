// Contract fixture: Prisma features whose DMMF shape hyde-db depends on (A19, A21, D34).
generator redacted {
  provider        = "hyde-db"
  output          = "./redacted"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// A user of the app
model User {
  /// @hyde.visible
  id     Int                      @id @default(autoincrement())
  /// @hyde.hidden
  email  String                   @unique @map("email_address")
  posts  Post[]
  /// @hyde.visible
  secret String?                  @ignore
  /// @hyde.visible
  geom   Unsupported("geometry")?
  /// @hyde.visible
  role   Role                     @default(USER)
  /// @hyde.visible
  tags   String[]

  @@map("users")
  @@schema("auth")
}

model Post {
  /// @hyde.visible
  id       Int  @id
  /// @hyde.visible
  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id])

  @@schema("public")
}

model Legacy {
  id Int @id

  @@ignore
  @@schema("public")
}

/// A read-only report
view UserInfo {
  /// @hyde.visible
  id    Int    @unique
  /// @hyde.hidden
  email String

  @@schema("public")
}

enum Role {
  USER
  ADMIN

  @@schema("public")
}
